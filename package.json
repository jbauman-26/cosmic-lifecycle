{
  "name": "cosmic-lifecycle",
  "version": "0.21.1",
  "description": "Your marketing data, ready for your AI agent. Connect ads, analytics, payments, email and CRM tools into a database you own, with a check on every number. Works with Claude Code, Cursor and Codex over MCP. Free, no account. Command: cosmic (or lifecycle).",
  "type": "module",
  "bin": {
    "cosmic": "dist/cli.js",
    "lifecycle": "dist/cli.js",
    "cosmic-lifecycle": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/write-llms.mjs && node scripts/write-metrics-doc.mjs && node scripts/write-personal-rules.mjs",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "snapshot": "node scripts/snapshot-registry.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.0.0",
    "pg": "^8.23.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist",
    "connectors/run.py",
    "connectors/personal-rules.json",
    "registry-snapshot",
    "llms.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jbauman-26/cosmic-lifecycle"
  },
  "keywords": [
    "klaviyo",
    "shopify",
    "lifecycle",
    "marketing",
    "mcp",
    "claude-code",
    "email-marketing",
    "saas",
    "b2b",
    "hubspot",
    "stripe",
    "marketing-data",
    "mcp-server",
    "ai-agent",
    "analytics",
    "google-ads",
    "meta-ads",
    "ga4"
  ],
  "author": "Cosmic AI"
}
